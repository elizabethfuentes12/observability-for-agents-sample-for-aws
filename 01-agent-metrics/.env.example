# Default: OpenAI gpt-4o-mini (just an API key to try; Strands runs any provider).
OPENAI_API_KEY=sk-proj-xxxxxx

# Duffel sandbox token for real flight search.
# Free at https://app.duffel.com -> More -> Developers -> Access tokens (test mode).
DUFFEL_API_KEY=duffel_test_xxxxxx

# Prefer Amazon Bedrock instead of OpenAI? Edit the model block in
# test_agent_metrics.py to use BedrockModel, then set your AWS region:
# AWS_REGION=us-west-2
